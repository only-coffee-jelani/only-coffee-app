# Application
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=only_coffee
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_POOL_MAX=20
DB_POOL_MIN=2

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=only-coffee:

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Auth0 (Optional - alternatively use AWS Cognito)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.onlycoffee.com

# Twilio Verify (for phone authentication - RECOMMENDED)
# 1. Create account at https://www.twilio.com
# 2. Get Account SID and Auth Token from Console
# 3. Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
# 4. Copy the Service SID and paste below
# NOTE: Verify API includes fraud protection, no phone number needed!
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-verify-service-sid

# Twilio Messaging (optional - only for welcome/marketing SMS, NOT verification)
# If you want to send non-verification messages, purchase a phone number
TWILIO_PHONE_NUMBER=+15551234567

# Toast POS API
TOAST_API_BASE_URL=https://ws-api.toasttab.com
TOAST_API_KEY=your-toast-api-key
TOAST_CLIENT_ID=your-toast-client-id
TOAST_CLIENT_SECRET=your-toast-client-secret
TOAST_RATE_LIMIT=1000

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# DoorDash Drive
DOORDASH_API_URL=https://openapi.doordash.com
DOORDASH_DEVELOPER_ID=your-developer-id
DOORDASH_KEY_ID=your-key-id
DOORDASH_SIGNING_SECRET=your-signing-secret

# Uber Direct
UBER_DIRECT_API_URL=https://api.uber.com/v1/customers
UBER_DIRECT_CUSTOMER_ID=your-customer-id
UBER_DIRECT_CLIENT_ID=your-client-id
UBER_DIRECT_CLIENT_SECRET=your-client-secret

# Grubhub
GRUBHUB_API_URL=https://api.grubhub.com
GRUBHUB_API_KEY=your-api-key
GRUBHUB_RESTAURANT_ID=your-restaurant-id

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=only-coffee-assets
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:account:only-coffee-events
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/only-coffee-queue

# Segment
SEGMENT_WRITE_KEY=your-segment-write-key

# Sentry
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Feature Flags
CONFIGCAT_SDK_KEY=your-configcat-sdk-key

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

 GOOGLE_CLIENT_ID=959339957405-tcmbul5a30adjpbppru24lqejidj2bos.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-secret-here>