{
  "name": "@only-coffee/gateway",
  "version": "1.0.0",
  "description": "API Gateway service for Only Coffee",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/services/gateway/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/services/gateway/src/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm migration:run -- -d ../../shared/src/database/data-source.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d ../../shared/src/database/data-source.ts",
    "db:backup": "ts-node -r tsconfig-paths/register ../../database/scripts/backup-media-assets.ts",
    "db:rebuild-schema": "ts-node -r tsconfig-paths/register ../../database/scripts/rebuild-database.ts",
    "db:seed": "ts-node -r tsconfig-paths/register ../../database/scripts/seed-lookup-tables.ts",
    "db:migrate-media": "ts-node -r tsconfig-paths/register ../../database/scripts/migrate-media-assets.ts",
    "db:rebuild": "npm run db:backup && npm run db:rebuild-schema && npm run db:seed && npm run db:migrate-media"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.645.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "@only-coffee/shared": "file:../../shared",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "luxon": "^3.7.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "stripe": "^20.0.0",
    "twilio": "^5.10.3",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  }
}
