# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# Source files (we deploy pre-built dist/)
services/*/src/
shared/src/

# Node modules (will be installed on server for correct platform)
node_modules/

# Development files
.DS_Store
.env
.env.local
.env.development
npm-debug.log

# Tests
test/
coverage/
*.test.ts
*.spec.ts

# Documentation
docs/
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Build artifacts to exclude
build/
*.tsbuildinfo
tsconfig.json
tsconfig.*.json

# We'll run npm install --production on the server
# So we need package.json but not devDependencies source files
