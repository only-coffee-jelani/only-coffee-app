{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["shared/src/*"],
      "@gateway/*": ["services/gateway/src/*"],
      "@orchestration/*": ["services/orchestration/src/*"],
      "@rewards/*": ["services/rewards/src/*"],
      "@delivery/*": ["services/delivery/src/*"],
      "@gifting/*": ["services/gifting/src/*"],
      "@social/*": ["services/social/src/*"],
      "@catering/*": ["services/catering/src/*"]
    }
  },
  "include": ["services/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
