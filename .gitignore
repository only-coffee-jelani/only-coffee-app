# ==============================================================================
# ONLY COFFEE - ENTERPRISE-LEVEL .GITIGNORE
# ==============================================================================
# This file ensures sensitive data, credentials, build artifacts, and
# environment-specific files are never committed to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# DEPENDENCIES
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# ------------------------------------------------------------------------------
# TESTING
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
junit.xml

# ------------------------------------------------------------------------------
# PRODUCTION BUILDS
# ------------------------------------------------------------------------------
build/
dist/
out/
.next/
.nuxt/

# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
MASTER.env
.envrc

# Backend environment files
backend/.env
backend/.env.*
backend/services/**/.env
backend/services/**/.env.*
backend/services/gateway/.env
backend/services/gateway/.env.*
backend/shared/.env

# Admin environment files
admin/.env
admin/.env.*

# Mobile environment files
mobile/.env
mobile/.env.*

