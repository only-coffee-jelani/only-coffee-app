# Only Coffee Android App Environment Configuration Example
# Copy this file to .env and fill in your actual values
# This file can be safely committed to version control

# App Configuration
APP_NAME=Only Coffee
APP_VERSION=1.0.0
BUILD_TYPE=debug

# API Configuration
API_BASE_URL=https://api.only-coffee.us
API_VERSION=v1
API_TIMEOUT=30000

# Authentication (Replace with your actual keys)
API_KEY=your_api_key_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Firebase Configuration (if using Firebase)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_API_KEY=your_firebase_api_key
# FIREBASE_APP_ID=your_firebase_app_id

# Google Maps API (for store locator)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Processing
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
# SQUARE_APPLICATION_ID=your_square_app_id

# Analytics
# GOOGLE_ANALYTICS_TRACKING_ID=UA-XXXXXXXX-X
# MIXPANEL_TOKEN=your_mixpanel_token

# Push Notifications
# FCM_SENDER_ID=your_fcm_sender_id
# ONESIGNAL_APP_ID=your_onesignal_app_id

# Social Media Integration
# FACEBOOK_APP_ID=your_facebook_app_id
# TWITTER_CONSUMER_KEY=your_twitter_consumer_key
# INSTAGRAM_CLIENT_ID=your_instagram_client_id

# Store Configuration
DEFAULT_STORE_ID=french-quarter-nola
ENABLE_DELIVERY=true
ENABLE_PICKUP=true
MAX_DELIVERY_DISTANCE=10.0

# Feature Flags
ENABLE_LOYALTY_PROGRAM=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true
ENABLE_ANALYTICS=true
ENABLE_CRASH_REPORTING=true

# Debug Configuration
DEBUG_MODE=true
ENABLE_LOGGING=true
LOG_LEVEL=DEBUG

# Network Configuration
NETWORK_TIMEOUT=30000
RETRY_COUNT=3
CACHE_SIZE=10485760

# Image Configuration
IMAGE_CACHE_SIZE=52428800
IMAGE_QUALITY=85
ENABLE_IMAGE_COMPRESSION=true

# Branding
BRAND_PRIMARY_COLOR=#FF93A3
BRAND_SECONDARY_COLOR=#FF93A3
BRAND_ACCENT_COLOR=#FF93A3
BACKGROUND_PRIMARY_COLOR=#FFFFFF
TEXT_PRIMARY_COLOR=#000000

# Store Information
COMPANY_NAME=Only Coffee
COMPANY_PHONE=(504) 417-1010
COMPANY_EMAIL=info@only-coffee.us
COMPANY_WEBSITE=https://www.only-coffee.us

# Legal
PRIVACY_POLICY_URL=https://www.only-coffee.us/privacy
TERMS_OF_SERVICE_URL=https://www.only-coffee.us/terms
SUPPORT_EMAIL=support@only-coffee.us

# Development
DEV_SERVER_URL=http://localhost:3000
STAGING_SERVER_URL=https://staging-api.only-coffee.us
PRODUCTION_SERVER_URL=https://api.only-coffee.us

# Build Configuration
ENABLE_PROGUARD=false
ENABLE_MINIFICATION=false
GENERATE_SOURCE_MAPS=true

# Testing
ENABLE_TEST_MODE=false
TEST_API_BASE_URL=https://test-api.only-coffee.us
MOCK_LOCATION_SERVICES=false

# Performance
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1

# Security
ENABLE_CERTIFICATE_PINNING=true
ENABLE_ROOT_DETECTION=false
OBFUSCATE_LOGS=false
