# ==============================================================================
# ONLY COFFEE - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file contains all environment variables needed for the Only Coffee app.
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file with real credentials to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development                    # Options: development, production
PORT=3000                               # Backend server port

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost                       # Database host (e.g., localhost, RDS endpoint)
DB_PORT=5432                            # PostgreSQL port (default: 5432)
DB_USERNAME=postgres                    # Database username
DB_PASSWORD=YOUR_DB_PASSWORD_HERE       # Database password (CHANGE THIS!)
DB_DATABASE=only_coffee                 # Database name

# Database Connection Pool Settings
DB_POOL_MAX=20                          # Maximum number of connections in pool
DB_POOL_MIN=2                           # Minimum number of connections in pool

# Database Behavior (Development only - ALWAYS false in production)
DB_SYNCHRONIZE=false                    # Auto-sync entities (DANGER: false in production!)
DB_LOGGING=false                        # Enable SQL query logging

# ------------------------------------------------------------------------------
# REDIS (Caching & Sessions)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost                    # Redis host
REDIS_PORT=6379                         # Redis port (default: 6379)
REDIS_PASSWORD=YOUR_REDIS_PASSWORD      # Redis password (CHANGE THIS!)
REDIS_DB=0                              # Redis database number (0-15)
REDIS_KEY_PREFIX=only-coffee:           # Prefix for all Redis keys

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_HERE_CHANGE_THIS  # JWT signing secret (MUST BE STRONG!)
JWT_EXPIRES_IN=15m                      # Access token expiration (e.g., 15m, 1h, 1d)
JWT_REFRESH_SECRET=YOUR_REFRESH_TOKEN_SECRET_HERE      # Refresh token secret (DIFFERENT from JWT_SECRET!)
JWT_REFRESH_EXPIRES_IN=7d               # Refresh token expiration

# ------------------------------------------------------------------------------
# STRIPE PAYMENT PROCESSING
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY        # Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE  # Stripe publishable key (starts with pk_test_ or pk_live_)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET         # Stripe webhook signing secret

# ------------------------------------------------------------------------------
# TOAST POS INTEGRATION
# ------------------------------------------------------------------------------
TOAST_API_BASE_URL=https://ws-api.toasttab.com          # Toast API base URL
TOAST_CLIENT_ID=YOUR_TOAST_CLIENT_ID                    # Toast API client ID
TOAST_CLIENT_SECRET=YOUR_TOAST_CLIENT_SECRET            # Toast API client secret
TOAST_RESTAURANT_GUID=YOUR_RESTAURANT_GUID              # Toast restaurant GUID
TOAST_RATE_LIMIT=1000                                   # API rate limit (requests per period)

# ------------------------------------------------------------------------------
# AWS S3 (File Storage)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1                                    # AWS region (e.g., us-east-1, us-west-2)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID                # AWS IAM access key ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY        # AWS IAM secret access key
AWS_S3_BUCKET=only-coffee-assets                        # S3 bucket name for app assets

# ------------------------------------------------------------------------------
# AWS ELASTIC BEANSTALK (Production Deployment)
# ------------------------------------------------------------------------------
EB_ENVIRONMENT_NAME=only-coffee-prod                    # Elastic Beanstalk environment name
EB_APPLICATION_NAME=only-coffee                         # Elastic Beanstalk application name

# ------------------------------------------------------------------------------
# MOBILE APP API ENDPOINTS
# ------------------------------------------------------------------------------
# iOS App Base URL
IOS_API_BASE_URL=http://only-coffee-prod.eba-p3bfu2px.us-east-1.elasticbeanstalk.com/api/v1

# Android App Base URL
ANDROID_API_BASE_URL=http://only-coffee-prod.eba-p3bfu2px.us-east-1.elasticbeanstalk.com/api/v1

# ------------------------------------------------------------------------------
# APPLE SERVICES (iOS)
# ------------------------------------------------------------------------------
# Apple Sign In (Required for iOS production)
APPLE_CLIENT_ID=YOUR_APPLE_SERVICE_ID                   # Apple Service ID
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID                        # Apple Developer Team ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID                          # Apple Sign In Key ID
APPLE_PRIVATE_KEY_PATH=/path/to/AuthKey.p8              # Path to Apple private key

# ------------------------------------------------------------------------------
# GOOGLE SERVICES (Android)
# ------------------------------------------------------------------------------
# Google Sign In
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID                  # Google OAuth client ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET          # Google OAuth client secret

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Optional - for notifications)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com                               # SMTP host
EMAIL_PORT=587                                          # SMTP port
EMAIL_SECURE=false                                      # Use TLS (true for port 465)
EMAIL_USER=noreply@onlycoffee.com                       # Email sender address
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD                      # Email account password or app password
EMAIL_FROM=Only Coffee <noreply@onlycoffee.com>         # From header

# ------------------------------------------------------------------------------
# TWILIO (Optional - for SMS notifications)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID              # Twilio account SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN                # Twilio auth token
TWILIO_PHONE_NUMBER=+1234567890                         # Twilio phone number

# ------------------------------------------------------------------------------
# MONITORING & LOGGING (Optional)
# ------------------------------------------------------------------------------
# Sentry Error Tracking
SENTRY_DSN=https://YOUR_SENTRY_DSN                      # Sentry DSN for error tracking

# Application Insights / Logging
LOG_LEVEL=info                                          # Log level: debug, info, warn, error
LOG_FORMAT=json                                         # Log format: json, text

# ------------------------------------------------------------------------------
# CORS & SECURITY
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001  # Allowed CORS origins (comma-separated)
RATE_LIMIT_WINDOW=60000                                 # Rate limit window (ms)
RATE_LIMIT_MAX=100                                      # Max requests per window

# ------------------------------------------------------------------------------
# FEATURE FLAGS (Optional)
# ------------------------------------------------------------------------------
ENABLE_REFERRAL_PROGRAM=true                            # Enable invite-a-friend feature
ENABLE_GIFT_CARDS=true                                  # Enable gift card purchases
ENABLE_REWARDS=true                                     # Enable loyalty rewards
ENABLE_REVIEWS=true                                     # Enable store reviews

# ==============================================================================
# SETUP NOTES
# ==============================================================================
#
# 1. Copy this file to .env in the backend/services/gateway directory:
#    cp .env.template backend/services/gateway/.env
#
# 2. Replace all placeholder values (YOUR_*_HERE) with actual credentials
#
# 3. For production deployment:
#    - Set NODE_ENV=production
#    - Use strong, unique secrets for JWT_SECRET and JWT_REFRESH_SECRET
#    - Use production Stripe keys (sk_live_ and pk_live_)
#    - Enable SSL for database (handled automatically when NODE_ENV=production)
#    - Set DB_SYNCHRONIZE=false (CRITICAL for production!)
#
# 4. Secure this file:
#    - Never commit .env to git (already in .gitignore)
#    - Use environment-specific files (.env.development, .env.production)
#    - For production, use AWS Secrets Manager or Parameter Store
#
# 5. Database Setup:
#    - Create PostgreSQL database: CREATE DATABASE only_coffee;
#    - Run migrations: npm run migration:run
#
# 6. Redis Setup:
#    - Install Redis: brew install redis (macOS) or apt-get install redis (Linux)
#    - Start Redis: redis-server
#
# 7. AWS S3 Setup:
#    - Create S3 bucket: only-coffee-assets
#    - Set bucket policy for public read access on promotions/* folder
#    - Upload promotion images to promotions/ folder
#
# 8. Generate Strong Secrets:
#    openssl rand -base64 64  # For JWT_SECRET
#    openssl rand -base64 64  # For JWT_REFRESH_SECRET
#
# ==============================================================================
